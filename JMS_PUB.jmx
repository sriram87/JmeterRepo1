          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def randomNum = new Random().nextInt(1000000) 
def timestamp = new Date().format(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSZ&quot;)

def jsonContent = &quot;&quot;&quot;
{
    &quot;event_type&quot;: &quot;ORDER_PLACED&quot;,
    &quot;transaction_id&quot;: &quot;${UUID.randomUUID().toString()}&quot;,
    &quot;amount&quot;: ${randomNum},
    &quot;timestamp&quot;: &quot;${timestamp}&quot;,
    &quot;user_info&quot;: &quot;User-${new Random().nextInt(1000)}&quot;
}
&quot;&quot;&quot;
// Store the generated content in a JMeter variable
vars.put(&quot;JMS_MESSAGE_CONTENT&quot;, jsonContent.stripIndent())</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
