        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import javax.jms.*;
import org.apache.activemq.artemis.jms.client.ActiveMQConnectionFactory;

public class JmsResponder {
    public static void main(String[] args) throws Exception {
        String brokerUrl = &quot;tcp://127.0.0.1:61616&quot;;
        String requestQueueName = &quot;REQ.QUEUE&quot;;

        // Connection factory
        ActiveMQConnectionFactory cf = new ActiveMQConnectionFactory(brokerUrl);
        Connection connection = cf.createConnection();
        connection.start();

        // Non-transacted, auto-ack
        Session session = connection.createSession(false, Session.AUTO_ACKNOWLEDGE);

        // Request queue
        Queue requestQueue = session.createQueue(requestQueueName);

        // Consumer for incoming requests
        MessageConsumer consumer = session.createConsumer(requestQueue);

        System.out.println(&quot;Responder listening on &quot; + requestQueueName);

        while (true) {
            Message request = consumer.receive();
            if (request == null) continue;

            String correlationId = request.getJMSCorrelationID();
            Destination replyDest = request.getJMSReplyTo();

            String body;
            if (request instanceof TextMessage) {
                body = ((TextMessage) request).getText();
            } else {
                body = &quot;Unsupported message type: &quot; + request.getClass().getSimpleName();
            }

            System.out.println(&quot;Received request: &quot; + body + &quot; (correlationId=&quot; + correlationId + &quot;)&quot;);

            // Create reply
            TextMessage reply = session.createTextMessage(&quot;Reply: &quot; + body);
            if (correlationId != null) {
                reply.setJMSCorrelationID(correlationId);
            }

            // Send reply back to the temporary queue
            MessageProducer producer = session.createProducer(replyDest);
            producer.send(reply);
            producer.close();

            System.out.println(&quot;Sent reply for correlationId=&quot; + correlationId);
        }
    }
}</stringProp>
          <stringProp name="scriptLanguage">java</stringProp>
        </JSR223Sampler>
